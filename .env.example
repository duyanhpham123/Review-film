# Sao chép thành .env rồi điền giá trị. KHÔNG đưa file .env lên git.
# Sinh chuỗi ngẫu nhiên: openssl rand -base64 48

# Địa chỉ người dùng truy cập (dùng cho link trong email, CORS, URL ảnh)
PUBLIC_URL=https://reviewfilm.example.com
# Dùng với --profile https: Caddy tự lấy chứng chỉ cho domain này (DNS phải trỏ về server)
DOMAIN=reviewfilm.example.com
# Có Caddy: 127.0.0.1:8080. Không dùng Caddy: 80
FRONTEND_BIND=127.0.0.1:8080
# Cookie refresh token chỉ gửi qua HTTPS. Chỉ đặt false khi chạy thử bằng http://
COOKIE_SECURE=true

MYSQL_ROOT_PASSWORD=
MYSQL_USER=reviewfilm
MYSQL_PASSWORD=

RABBITMQ_USER=reviewfilm
RABBITMQ_PASSWORD=

MINIO_ROOT_USER=reviewfilm
# Tối thiểu 8 ký tự
MINIO_ROOT_PASSWORD=

# Tối thiểu 32 ký tự
JWT_SECRET=

# SMTP gửi mail xác thực / quên mật khẩu (Gmail cần App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Không bắt buộc: import phim từ TMDB
TMDB_READ_TOKEN=
